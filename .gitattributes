# Keep hashed Step 8 text artifacts byte-stable across platforms.
data/processed/selected_original_passages.csv text eol=lf
data/processed/selected_passages_md/*.md text eol=lf
metadata/selected_original_passage_metadata.csv text eol=lf
metadata/selected_counts_by_author.csv text eol=lf
metadata/selected_counts_by_work.csv text eol=lf
metadata/selection_summary.csv text eol=crlf
metadata/selection_filter_report.csv text eol=lf
metadata/selected_passage_md_manifest.csv text eol=crlf
metadata/step8_output_manifest.csv text eol=crlf

# V2 generated artifacts are LF on every OS. Downloaded source bytes are immutable.
research_v2/** text eol=lf
tests/** text eol=lf
revision/** text eol=lf
revision/sources/*.txt -text
revision/sources/*.txt -whitespace
revision/agent_rewrite/outputs/*.json -text -whitespace
revision/corpus/excluded_source_blocks.csv -whitespace
revision/history/** -whitespace
requirements-v2.in text eol=lf
requirements-v2.lock text eol=lf
revision/annotations/returns/*.csv -text
.github/workflows/*.yml text eol=lf

# Preserve hashed compressed transforms and rendered artifacts byte-for-byte.
*.gz -text
*.zip -text
*.docx -text
*.pdf -text
*.png -text
*.jpg -text
*.jpeg -text
revision/paper_assets/document_build.json -text

# Whitespace inside preserved provider prose and historical receipts is evidence.
revision/**/*.csv -whitespace
revision/verification/*.xml -text -whitespace
revision/expanded_v3/verification/*.xml -text -whitespace
revision/paper_assets/document_build.json -whitespace
revision/extensions/codex51_audit/20260925T211904Z/AUDIT.md -whitespace
